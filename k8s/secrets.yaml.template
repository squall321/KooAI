# IMPORTANT: This is a template file. DO NOT commit actual secrets!
# Copy this file to secrets.yaml and replace the placeholder values.
# Then create secrets using: kubectl apply -f secrets.yaml

# To encode secrets: echo -n "your-secret-value" | base64

apiVersion: v1
kind: Secret
metadata:
  name: kooai-secrets
  namespace: kooai
  labels:
    app.kubernetes.io/name: kooai
    app.kubernetes.io/component: secrets
type: Opaque
data:
  # Database credentials (base64 encoded)
  # Example: echo -n "kooai" | base64
  POSTGRES_USER: a29vYWk=  # kooai
  POSTGRES_PASSWORD: Q0hBTkdFX01FX1NUUk9OR19QQVNTV09SRA==  # CHANGE_ME_STRONG_PASSWORD

  # Redis password (base64 encoded)
  REDIS_PASSWORD: Q0hBTkdFX01FX1JFRElTX1BBU1NXT1JE  # CHANGE_ME_REDIS_PASSWORD

  # Application secret key (base64 encoded)
  # Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
  SECRET_KEY: R0VORVJBVEVEX0FfU0VDVVJFX1JBTkRPTV9TRUNSRVRfS0VZX0hFUkU=  # GENERATE_A_SECURE_RANDOM_SECRET_KEY_HERE

---
# Optional: External service credentials
apiVersion: v1
kind: Secret
metadata:
  name: kooai-external-secrets
  namespace: kooai
  labels:
    app.kubernetes.io/name: kooai
    app.kubernetes.io/component: external-secrets
type: Opaque
data:
  # OpenAI API Key (optional, base64 encoded)
  OPENAI_API_KEY: ""

  # Anthropic API Key (optional, base64 encoded)
  ANTHROPIC_API_KEY: ""

  # AWS credentials for S3 (optional, base64 encoded)
  AWS_ACCESS_KEY_ID: ""
  AWS_SECRET_ACCESS_KEY: ""
