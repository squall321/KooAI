# KooAI Production Environment Configuration
# Copy this file to .env.production and update with production values
# IMPORTANT: Never commit .env.production to version control!

# Application
KOOAI_ENV=production
DEBUG=false
LOG_LEVEL=INFO
VERSION=1.0.0

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_REPLICAS=2

# Database (IMPORTANT: Change these!)
POSTGRES_USER=kooai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=kooai
POSTGRES_PORT=5432

# Redis (IMPORTANT: Change this!)
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

# Security (IMPORTANT: Generate secure keys!)
SECRET_KEY=GENERATE_A_SECURE_RANDOM_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (Update with your frontend domains)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_CREDENTIALS=true

# Storage
STORAGE_TYPE=local
STORAGE_PATH=/app/data
MAX_UPLOAD_SIZE=104857600

# Logging
LOG_FORMAT=json
LOG_FILE=/app/logs/kooai.log

# Performance
CACHE_TTL=3600
QUERY_TIMEOUT=30

# Monitoring (Optional)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Optional: Cloud Storage (if using S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=kooai-production

# Optional: LLM Integration
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4
# ANTHROPIC_API_KEY=
