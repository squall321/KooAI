# KooAI 환경 설정 (Environment Variables)

#############################################
# 데이터베이스 설정 (Database)
#############################################

# 방법 1: DATABASE_URL 사용 (권장 - Docker/Apptainer)
# 전체 연결 정보를 하나의 URL로 지정
DATABASE_URL=postgresql://kooai:changeme_password@localhost:5432/kooai

# 방법 2: 개별 변수 사용 (로컬 개발)
# DATABASE_URL이 설정되면 아래 변수들은 무시됩니다
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=kooai
#DB_USER=kooai
#DB_PASSWORD=changeme_password

# 연결 풀 설정 (Connection Pool)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# 디버깅 (Database Debugging)
DB_ECHO=false
DB_ECHO_POOL=false

# 테스트 모드 (Test Mode)
# true로 설정하면 SQLite in-memory 데이터베이스 사용
USE_TEST_DB=false

# 애플리케이션 설정 (Application Configuration)
KOOAI_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API 설정 (API Configuration)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

#############################################
# Redis/Cache 설정
#############################################

# 방법 1: REDIS_URL 사용 (권장 - Docker/Apptainer)
REDIS_URL=redis://localhost:6379/1

# 방법 2: 개별 변수 사용 (로컬 개발)
# REDIS_URL이 설정되면 아래 변수들은 무시됩니다
#CACHE_REDIS_HOST=localhost
#CACHE_REDIS_PORT=6379
#CACHE_REDIS_DB=1
#CACHE_REDIS_PASSWORD=

# Cache TTL 설정 (Time To Live)
CACHE_DEFAULT_TTL=3600
CACHE_ANALYSIS_TTL=86400

# 파일 저장 경로 (File Storage)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MODEL_DIR=./models

#############################################
# 보안 설정 (Security)
#############################################

# SECRET_KEY 생성 방법:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 또는:
#   openssl rand -hex 32
SECRET_KEY=changeme_generate_secure_random_key_using_command_above

# CORS 설정 (쉼표로 구분, 프로덕션에서는 특정 도메인만 허용)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# 프로덕션 예시: ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# AI/ML 설정 (AI/ML Configuration)
# OpenAI API Key (선택사항)
OPENAI_API_KEY=

# Anthropic API Key (선택사항)
ANTHROPIC_API_KEY=

# Hugging Face Token (선택사항)
HUGGINGFACE_TOKEN=
