# Environment Configuration

# Application
ENV=development
DEBUG=true
APP_NAME=KooAI
VERSION=0.1.0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql+asyncpg://kooai:kooai_password@localhost:5432/kooai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector Database (pgvector)
VECTOR_DB_URL=postgresql+asyncpg://kooai:kooai_password@localhost:5432/kooai
EMBEDDING_DIMENSION=1536

# File Storage
STORAGE_TYPE=local  # local, s3
STORAGE_PATH=/data/storage
MAX_UPLOAD_SIZE=1073741824  # 1GB in bytes

# S3 (Optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=kooai-storage

# AI Models Storage
MODEL_STORAGE_PATH=/data/models
MODEL_CACHE_SIZE=5

# LLM (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Anthropic (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_HOST=localhost
JAEGER_PORT=6831

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json, text
LOG_FILE=/var/log/kooai/app.log

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# VAE Model
VAE_LATENT_DIM=16
VAE_HIDDEN_DIMS=128,64,32
VAE_LEARNING_RATE=0.001
VAE_BATCH_SIZE=32
VAE_EPOCHS=100

# Training
TRAINING_DEVICE=cuda  # cuda, cpu
TRAINING_MIXED_PRECISION=true
TRAINING_CHECKPOINT_DIR=/data/checkpoints

# Cache TTL (seconds)
CACHE_TTL_SIMULATION=3600
CACHE_TTL_ANALYSIS=1800
CACHE_TTL_EMBEDDING=86400

# Plugin System
PLUGIN_DIR=/app/plugins
PLUGIN_AUTO_DISCOVER=true

# Performance
WORKER_TIMEOUT=300
MAX_CONCURRENT_TASKS=10
ASYNC_POOL_SIZE=100
