# KooAI 환경 설정 (Environment Variables)

# 데이터베이스 설정 (Database Configuration)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kooai
DB_USER=kooai
DB_PASSWORD=changeme_securepassword

# 데이터베이스 연결 풀 설정 (Connection Pool)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# 데이터베이스 디버깅 (Database Debugging)
DB_ECHO=false
DB_ECHO_POOL=false

# 테스트 모드 (Test Mode)
# true로 설정하면 SQLite in-memory 데이터베이스 사용
USE_TEST_DB=false

# 애플리케이션 설정 (Application Configuration)
KOOAI_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API 설정 (API Configuration)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Redis 설정 (Redis Configuration) - 선택사항
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 파일 저장 경로 (File Storage)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MODEL_DIR=./models

# 보안 설정 (Security)
SECRET_KEY=changeme_generate_secure_random_key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# AI/ML 설정 (AI/ML Configuration)
# OpenAI API Key (선택사항)
OPENAI_API_KEY=

# Anthropic API Key (선택사항)
ANTHROPIC_API_KEY=

# Hugging Face Token (선택사항)
HUGGINGFACE_TOKEN=
