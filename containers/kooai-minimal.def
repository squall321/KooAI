Bootstrap: docker
From: python:3.11-slim

%labels
    Author KooAI Team
    Version 1.0.0
    Profile minimal

%files
    . /opt/kooai/

%post
    apt-get update && apt-get install -y build-essential git
    apt-get clean && rm -rf /var/lib/apt/lists/*

    cd /opt/kooai
    python3 -m venv venv
    . venv/bin/activate
    pip install --upgrade pip
    pip install -e ".[minimal]"

%environment
    export PATH=/opt/kooai/venv/bin:$PATH
    export PYTHONPATH=/opt/kooai:$PYTHONPATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    cd /opt/kooai
    exec venv/bin/python -m uvicorn src.presentation.api.main:app --host 0.0.0.0 --port ${PORT:-8000}

%test
    python3 --version
