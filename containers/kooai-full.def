Bootstrap: docker
From: python:3.11-slim

%labels
    Author KooAI Team
    Version 1.0.0
    Profile full

%post
    # Install system dependencies including development tools
    apt-get update && apt-get install -y \
        build-essential \
        git \
        cmake \
        gfortran \
        libhdf5-dev \
        libvtk9-dev \
        python3-vtk9 \
        libgl1-mesa-glx \
        libglu1-mesa \
        libxrender1 \
        libsm6 \
        libxext6 \
        libopenblas-dev \
        liblapack-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff-dev \
        libavcodec-dev \
        libavformat-dev \
        libswscale-dev \
        libv4l-dev \
        libxvidcore-dev \
        libx264-dev \
        wget \
        && apt-get clean && rm -rf /var/lib/apt/lists/*
    
    # Create application directory
    mkdir -p /opt/kooai && cd /opt/kooai
    
    # Create virtual environment
    python3 -m venv venv
    . venv/bin/activate
    
    # Upgrade pip
    pip install --upgrade pip setuptools wheel
    
    # Install KooAI core dependencies
    pip install \
        fastapi \
        uvicorn[standard] \
        pydantic \
        pydantic-settings \
        sqlalchemy \
        alembic \
        psycopg2-binary \
        redis \
        celery \
        structlog \
        prometheus-client
    
    # Install 3D processing libraries
    pip install \
        vtk \
        pyvista \
        meshio \
        trimesh \
        open3d
    
    # Install scientific computing
    pip install \
        numpy \
        scipy \
        pandas \
        h5py \
        scikit-learn \
        scikit-image
    
    # Install PyTorch (CPU version for broader compatibility)
    pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu
    
    # Install TensorFlow (CPU version)
    pip install tensorflow-cpu
    
    # Install additional ML/DL tools
    pip install \
        transformers \
        datasets \
        accelerate \
        optuna \
        ray[tune]
    
    # Install visualization and analysis
    pip install \
        matplotlib \
        seaborn \
        plotly \
        bokeh \
        ipython \
        jupyter \
        jupyterlab
    
    # Install utility libraries
    pip install \
        httpx \
        python-multipart \
        python-jose[cryptography] \
        passlib[bcrypt] \
        aiofiles \
        Pillow \
        click \
        rich \
        tqdm
    
    # Install testing and quality tools
    pip install \
        pytest \
        pytest-cov \
        pytest-asyncio \
        pytest-xdist \
        pytest-benchmark \
        black \
        isort \
        flake8 \
        mypy \
        pylint

%environment
    export PATH=/opt/kooai/venv/bin:$PATH
    export PYTHONPATH=/opt/kooai:$PYTHONPATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Optimize for CPU-only execution
    export OMP_NUM_THREADS=4
    export MKL_NUM_THREADS=4
    export OPENBLAS_NUM_THREADS=4

%runscript
    cd /opt/kooai
    exec venv/bin/python -m uvicorn src.presentation.api.main:app --host 0.0.0.0 --port ${PORT:-8000}

%test
    . /opt/kooai/venv/bin/activate
    python3 --version
    python3 -c "import vtk; print(f'VTK version: {vtk.vtkVersion.GetVTKVersion()}')"
    python3 -c "import pyvista; print(f'PyVista version: {pyvista.__version__}')"
    python3 -c "import torch; print(f'PyTorch version: {torch.__version__}')"
    python3 -c "import tensorflow as tf; print(f'TensorFlow version: {tf.__version__}')"
    python3 -c "import sklearn; print(f'scikit-learn version: {sklearn.__version__}')"
    python3 -c "import fastapi; print(f'FastAPI version: {fastapi.__version__}')"

%help
    KooAI Full Image - Complete installation with AI/ML capabilities
    
    Includes:
    - All standard image packages
    - PyTorch (CPU)
    - TensorFlow (CPU)
    - Hugging Face Transformers
    - Advanced ML tools (Ray, Optuna)
    - Jupyter notebooks
    - Open3D for 3D deep learning
    - Complete testing and quality tools
    
    This image is designed for:
    - AI/ML model training and inference
    - Advanced data analysis
    - Research and development
    - Complete HPC workflows
    
    Size: ~4GB (larger but includes everything)
    
    Usage:
        apptainer run kooai-full.sif
        apptainer exec kooai-full.sif python script.py
        apptainer exec kooai-full.sif jupyter lab --ip=0.0.0.0
        apptainer shell kooai-full.sif
    
    For more information: https://github.com/your-org/KooAI
